# Copy to staging.env (git-ignored) and fill in. Never commit real values.
ENVIRONMENT=staging
DATABASE_URL=postgresql://user:password@host:5432/verilab
SECRET_KEY=generate-a-long-random-value
ALLOWED_ORIGINS=https://your-frontend.example.com
OCR_PROVIDER=rapidocr
STORAGE_DIR=/var/data/uploads
DEMO_USER_PASSWORD=
