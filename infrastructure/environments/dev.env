# Verilab — Development Environment
# Copy this to backend/.env for local development WITHOUT Docker
# When using Docker, these are injected via docker-compose.yml

DATABASE_URL=postgresql://verilab:verilab_dev_password@localhost:5432/verilab_dev
SECRET_KEY=dev_only_insecure_secret_key_change_before_staging
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_BYTES=10485760
ENVIRONMENT=development

# OCR Provider — set to "mock" for Phase 1, "textract" for Phase 2
OCR_PROVIDER=mock

# Notification provider — set to "mock" for Phase 1
NOTIFICATION_PROVIDER=mock
